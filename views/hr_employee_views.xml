<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_inherit_training" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.training</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <!-- Smart Button in Button Box -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_trainings"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-graduation-cap"
                        groups="hr.group_hr_user">
                    <field name="training_count" widget="statinfo" string="Trainings"/>
                </button>
            </xpath>

            <!-- Training Tab in Notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Training" name="training_tab" groups="hr.group_hr_user">
                    <field name="training_session_ids" readonly="1">
                        <list string="Trainings Taken">
                            <field name="name" string="Reference"/>
                            <field name="title"/>
                            <field name="training_type"/>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="venue"/>
                            <field name="state" widget="badge"
                                   decoration-info="state == 'draft'"
                                   decoration-primary="state == 'planned'"
                                   decoration-success="state == 'done'"
                                   decoration-muted="state == 'cancelled'"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
