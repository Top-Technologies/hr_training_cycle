<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_hr_training_session_tree" model="ir.ui.view">
        <field name="name">hr.training.session.list</field>
        <field name="model">hr.training.session</field>
        <field name="arch" type="xml">
            <list string="Training Sessions" sample="1">
                <field name="name"/>
                <field name="title"/>
                <field name="assessment_id" optional="show"/>
                <field name="training_title_id" optional="hide"/>
                <field name="training_type" widget="badge"
                       decoration-info="training_type == 'internal'"
                       decoration-warning="training_type == 'external'"/>
                <field name="trainer"/>
                <field name="venue"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="actual_cost" sum="Total Cost"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-primary="state == 'planned'"
                       decoration-success="state == 'done'"
                       decoration-muted="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hr_training_session_form" model="ir.ui.view">
        <field name="name">hr.training.session.form</field>
        <field name="model">hr.training.session</field>
        <field name="arch" type="xml">
            <form string="Training Attendance (HR-OF-010)">
                <header>
                    <button name="action_confirm"
                            string="Confirm Session"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'draft'"/>
                    <button name="action_close"
                            string="Close Training"
                            type="object"
                            class="oe_highlight"
                            invisible="state != 'planned'"/>
                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            invisible="state not in ('draft', 'planned')"/>
                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,planned,done"/>
                </header>
                <sheet>
                    <!-- Completed Session Status Banner -->
                    <div class="alert alert-success d-flex align-items-center justify-content-between p-2 mb-2" role="status" invisible="state != 'done'">
                        <div>
                            <i class="fa fa-check-circle me-1"/> <strong>Training Session Completed!</strong> Post-training evaluations have been automatically dispatched for participants.
                        </div>
                        <div class="d-flex gap-3">
                            <span><strong>Enrolled:</strong> <field name="total_attendees" readonly="1" class="oe_inline"/></span>
                            <span><strong>Attended:</strong> <field name="present_attendees" readonly="1" class="oe_inline"/></span>
                            <span><strong>Attendance Rate:</strong> <field name="attendance_rate" readonly="1" class="oe_inline"/>%</span>
                        </div>
                    </div>

                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_evaluations"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-graduation-cap"
                                invisible="evaluation_count == 0">
                            <field name="evaluation_count" widget="statinfo" string="Evaluations"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Session Reference"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Need Assessment &amp; Objectives">
                            <field name="assessment_id"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   readonly="state == 'done'"/>
                            <field name="training_title_id"
                                   domain="[('need_id', '=', assessment_id)] if assessment_id else [('need_id.state', '=', 'approved')]"
                                   options="{'no_create': True, 'no_create_edit': True}"
                                   readonly="state == 'done'"/>
                            <field name="department_id" invisible="not department_id"/>
                            <field name="department_head_id" invisible="not department_head_id"/>
                            <field name="training_duration" invisible="training_duration == 0"/>
                            <field name="proposed_budget" invisible="proposed_budget == 0"/>
                            <field name="title" invisible="1"/>
                            <field name="target_group" readonly="state == 'done'"/>
                            <field name="venue" readonly="state == 'done'"/>
                        </group>
                        <group string="Logistics &amp; Trainer">
                            <field name="training_type" widget="radio" options="{'horizontal': True}" readonly="state == 'done'"/>
                            <field name="trainer_employee_id"
                                   invisible="training_type != 'internal'"
                                   required="training_type == 'internal'"
                                   readonly="state == 'done'"/>
                            <field name="provider_id"
                                   invisible="training_type != 'external'"
                                   required="training_type == 'external'"
                                   readonly="state == 'done'"/>
                            <field name="external_trainer"
                                   invisible="training_type != 'external'"
                                   readonly="state == 'done'"/>
                            <field name="trainer" invisible="1"/>
                            <field name="start_date" readonly="1"/>
                            <field name="end_date" readonly="1"/>
                            <field name="actual_cost" readonly="state == 'done'"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Training Days" name="training_days">
                            <field name="day_ids" readonly="state == 'done'">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="name" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Attendees &amp; Attendance" name="attendance">
                            <field name="attendee_ids" readonly="state == 'done'">
                                <list editable="bottom">
                                    <field name="employee_id"/>
                                    <field name="job_id"/>
                                    <field name="department_id"/>
                                    <field name="attended_day_ids" widget="many2many_tags"
                                           options="{'no_create': True}"
                                           domain="[('session_id', '=', parent.id)]"/>
                                    <field name="days_attended_count" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Evaluations &amp; Results" name="evaluations" invisible="state != 'done' and evaluation_count == 0">
                            <field name="evaluation_ids" readonly="1">
                                <list decoration-success="state == 'completed'"
                                      decoration-warning="state == 'awaiting_followup'"
                                      decoration-info="state == 'awaiting_trainee'">
                                    <field name="name" string="Assessment Reference"/>
                                    <field name="trainee_id" string="Trainee"/>
                                    <field name="evaluator_id" string="Evaluator / Manager"/>
                                    <field name="part_b_due_date" string="6-Month Follow-Up"/>
                                    <field name="average_score" string="Avg Score (1-4)"/>
                                    <field name="met_goal" string="Goal Result" widget="badge"
                                           decoration-success="met_goal == 'yes'"
                                           decoration-danger="met_goal == 'no'"
                                           decoration-warning="met_goal == 'partially'"/>
                                    <field name="state" string="Evaluation Status" widget="badge"
                                           decoration-info="state == 'awaiting_trainee'"
                                           decoration-warning="state == 'awaiting_followup'"
                                           decoration-success="state == 'completed'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Expected Competencies / Outcomes" name="expected_results" invisible="not expected_result">
                            <group>
                                <field name="expected_result" string="Expected Outcome" readonly="1"/>
                            </group>
                        </page>
                        <page string="Notice &amp; Instructions" name="notice">
                            <field name="notice" placeholder="Special instructions, materials required, or trainee notice..." readonly="state == 'done'"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hr_training_session_search" model="ir.ui.view">
        <field name="name">hr.training.session.search</field>
        <field name="model">hr.training.session</field>
        <field name="arch" type="xml">
            <search string="Search Training Sessions">
                <field name="name" string="Reference"/>
                <field name="title"/>
                <field name="assessment_id"/>
                <field name="training_title_id"/>
                <field name="trainer"/>
                <field name="trainer_employee_id"/>
                <field name="provider_id"/>
                <field name="venue"/>
                <separator/>
                <filter name="internal_training" string="Internal Training" domain="[('training_type', '=', 'internal')]"/>
                <filter name="external_training" string="External Training" domain="[('training_type', '=', 'external')]"/>
                <separator/>
                <filter name="draft" string="Draft" domain="[('state', '=', 'draft')]"/>
                <filter name="planned" string="Planned" domain="[('state', '=', 'planned')]"/>
                <filter name="done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="cancelled" string="Cancelled" domain="[('state', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_assessment" string="Assessment Reference" domain="[]" context="{'group_by': 'assessment_id'}"/>
                    <filter name="group_training_type" string="Training Type" domain="[]" context="{'group_by': 'training_type'}"/>
                    <filter name="group_trainer" string="Trainer / Institution" domain="[]" context="{'group_by': 'trainer'}"/>
                    <filter name="group_state" string="Status" domain="[]" context="{'group_by': 'state'}"/>
                    <filter name="group_start_date" string="Start Date" domain="[]" context="{'group_by': 'start_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hr_training_session" model="ir.actions.act_window">
        <field name="name">Training Sessions</field>
        <field name="res_model">hr.training.session</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_hr_training_session_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Plan a new Training Session (HR-OF-010)
            </p>
            <p>
                Schedule training dates, select a training title to load attendees, track daily attendance, and close training to trigger evaluations.
            </p>
        </field>
    </record>
</odoo>
