<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence for Training Need Assessment -->
        <record id="seq_hr_training_need" model="ir.sequence">
            <field name="name">Training Need Assessment Reference</field>
            <field name="code">hr.training.need</field>
            <field name="prefix">TNA/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <!-- Sequence for Training Session -->
        <record id="seq_hr_training_session" model="ir.sequence">
            <field name="name">Training Session Reference</field>
            <field name="code">hr.training.session</field>
            <field name="prefix">TRN/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>

        <!-- Sequence for Training Evaluation -->
        <record id="seq_hr_training_evaluation" model="ir.sequence">
            <field name="name">Training Evaluation Reference</field>
            <field name="code">hr.training.evaluation</field>
            <field name="prefix">EVAL/%(year)s/</field>
            <field name="padding">4</field>
            <field name="number_increment">1</field>
            <field name="number_next">1</field>
        </record>
    </data>
</odoo>
